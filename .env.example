# ElevateU Client Environment Configuration Template
# Duplicate this file to .env in the same directory and replace placeholder values with your real configuration.

# Base API endpoint for existing backend services
VITE_API_URL=https://api.elevateu.in/v1

# Public Supabase browser configuration (publishable/anon key only)
VITE_SUPABASE_URL=https://jdjgasrypbnkknlomxdf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Lif9rDPKweI1ZBzQ2BWD2A_UbxKllMr
NEXT_PUBLIC_SUPABASE_URL=https://jdjgasrypbnkknlomxdf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Lif9rDPKweI1ZBzQ2BWD2A_UbxKllMr

# Client ID for Google Single Sign-On (OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# Server-side only: configure in Supabase Edge Function secrets, never in VITE_/NEXT_PUBLIC_ variables.
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
LLM_PROVIDER_ORDER=groq,cerebras
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Server-side only: random 32-byte key encoded as 64 hexadecimal characters.
KEY_ENCRYPTION_SECRET=replace-with-64-hex-character-random-secret

# Default AI provider credentials used by client-invoked features (e.g. resume analysis)
# when the server-side secrets above are not configured. Comma-separated lists supported;
# the first working key/provider is used and failures automatically fall through to the next.
# Note: VITE_ variables are embedded in the client bundle — use only low-rate-limit keys here.
VITE_PUBLIC_GROQ_KEYS=your-groq-key[,second-groq-key]
VITE_PUBLIC_CEREBRAS_KEYS=your-cerebras-key[,second-cerebras-key]
VITE_LLM_PROVIDER_ORDER=groq,cerebras
